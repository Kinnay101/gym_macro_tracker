<?xml version="1.0" encoding="utf-8"?>
<!--
  Sicherung ab Android 12 (Prüfbericht D10).
  Die WebView speichert alle App-Daten (Trainings, Gewicht, Schlaf …) und die Anmeldung (Supabase-Token) im selben
  localStorage – trennen lässt sich das nicht. Darum:
  - Google-Cloud-Sicherung: nichts. Keine Gesundheitsdaten und keine Anmeldung in Google Drive.
    Wer ein Konto hat, bekommt alles über den Sync zurück; ohne Konto: Profil → Daten → Exportieren.
  - Umzug auf ein neues Handy (Kabel/direkt, nicht über die Cloud): alles mitnehmen, damit Daten und Anmeldung bleiben.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
